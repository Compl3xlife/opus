{
  "manifest_version": 3,
  "name": "Opus Bridge",
  "version": "0.5.5",
  "description": "Feeds the active browser tab to Opus and runs click/type/navigate/chess/mania/showdown commands.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Opus",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "activeTab", "storage", "downloads", "scripting", "alarms", "offscreen"],
  "host_permissions": [
    "http://127.0.0.1:5840/*",
    "http://localhost:5840/*",
    "http://*/*",
    "https://*/*"
  ]
}
