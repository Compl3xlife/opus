{
  "manifest_version": 3,
  "name": "Opus Bridge",
  "version": "0.2.0",
  "description": "Connects Firefox to Opus for tab context and game/browser actions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Opus",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["tabs", "activeTab", "storage", "downloads", "scripting"],
  "host_permissions": ["http://127.0.0.1:5840/*", "http://localhost:5840/*", "<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "opus-bridge@local",
      "strict_min_version": "121.0"
    }
  }
}
